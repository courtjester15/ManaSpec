{
  "name": "manaspec-react-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:canonical": "vite build --mode canonical",
    "build:pages": "vite build --mode pages && node tools/sync-pages.mjs && node ../tools/check-react-spike-artifact.mjs --write && node ../tools/check-react-spike-artifact.mjs",
    "build:portable": "vite build --config vite.portable.config.js && node tools/finalize-portable.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-isolation=none",
    "lint": "node tools/check-source.mjs",
    "format:check": "node tools/check-format.mjs",
    "lint:js": "eslint src tools *.config.js eslint.config.mjs"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "tabulator-tables": "6.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "vite": "8.1.3"
  }
}
